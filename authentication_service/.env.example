# Copy this file to .env and fill in your values for local development

# Database Configuration
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=app@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=app@gmail.com
EMAIL_FROM_NAME="SmartHealthCare App Support"

# Frontend URL for reset link
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=5
FRONTEND_URL=http://localhost:3000

# YouVerify API configuration for KYC verification
YOUVERIFY_API_URL=https://api.sandbox.youverify.co/v2/api/verifications/ng/company/basic
YOUVERIFY_API_KEY=your-youverify-api-key

# Dojah API configuration for KYC verification
DOJAH_API_URL=https://sandbox.dojah.io/api/v1/kyc/cac/basic
DOJAH_API_KEY=your-dojah-api-key
DOJAH_APP_ID=your-dojah-app-id
